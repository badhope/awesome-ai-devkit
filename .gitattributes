# Normalize line endings and set file types
* text=auto

# Source files — LF
*.py   text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf

# Batch / PowerShell — LF in repo
*.ps1  text eol=lf
*.bat  text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary

# Python bytecode
__pycache__/ export-ignore
*.pyc     export-ignore

# Repo-specific (for generated source archives)
.gitignore    export-ignore
.github/      export-ignore
.gitattributes export-ignore