{
  "name": "fullstack-expert",
  "version": "1.0.0",
  "description": "Awesome AI DevKit 全栈开发终极专家——整合框架全部 11 层能力，跨角色/技能/工具统一编排，输出从需求到上线的完整交付物",
  "author": "Awesome AI DevKit Team",
  "license": "MIT",
  "platforms": ["catpaw", "cursor", "cline", "github-copilot"],

  "interface": {
    "displayName": {
      "zh-CN": "全栈开发专家",
      "en": "Fullstack Expert"
    },
    "shortDescription": {
      "zh-CN": "11 层全栈开发框架：19 技能 × 19 工具 × 11 MCP × 完整工作流",
      "en": "11-layer fullstack framework: 19 skills × 19 tools × 11 MCP × complete workflows"
    },
    "tags": ["fullstack", "ai-devkit", "multi-agent", "saas", "coding"]
  },

  "layers": {
    "rules": {
      "path": "../../rules/",
      "files": [
        "rules/coding-standards.md",
        "rules/security-checklist.md",
        "rules/collaboration-rules.md"
      ]
    },
    "prompts": {
      "path": "../../roles/expanded/",
      "roles": [
        "product-manager", "security-engineer", "ai-engineer",
        "database-architect", "ui-designer", "sre-engineer",
        "technical-writer", "scrum-master", "data-engineer",
        "ml-engineer", "mobile-developer"
      ]
    },
    "tools": {
      "categories": {
        "web": ["html_to_markdown", "json_validator", "openapi_parser"],
        "ai": ["llm_client", "embedding_client", "prompt_builder"],
        "db": ["postgres_client", "qdrant_client", "redis_client"],
        "cli": ["dev_server", "test_runner", "project_scaffolder"],
        "implementations": ["api_client", "database_query", "file_operations", "git_operations", "shell_executor", "code_execution", "web_search"]
      }
    },
    "mcp": {
      "path": "../../scenarios/programming/fullstack/mcp/",
      "config": "mcp-config.yaml",
      "servers": [
        "filesystem", "git", "github", "postgres",
        "redis", "docker", "playwright", "stripe", "resend",
        "sentry", "figma", "qdrant", "notion", "slack",
        "linear", "vercel", "exa", "helicone", "supabase"
      ]
    },
    "skills": {
      "path": "../../framework/skills/",
      "count": 33,
      "categories": {
        "workflow": ["scaffold-workflow", "instruction-grooming", "task-tracker", "integration-patterns", "commit-conventions"],
        "quality": ["code-duplication", "mutation-testing", "linter-formatter", "loop-verification", "project-health", "code-review", "debugging", "test-strategy", "performance-optimization", "documentation-writing"],
        "security": ["security-governance", "sub-agent-guard", "dependency-audit", "secret-scanner"],
        "architecture": ["architecture-design", "api-design", "requirements-analysis"],
        "context": ["context-compression", "memory-management", "memory-persistent", "model-routing"],
        "infra": ["devkit-infra", "devkit-utilities", "calculator-math", "auto-heal"],
        "release": ["semantic-release", "git-workflow"],
        "frontend": ["web-browser-vision"]
      }
    },
    "agents": {
      "orchestration": "supervisor",
      "routing": "intent-based"
    },
    "workflows": {
      "path": "../../scenarios/programming/fullstack/workflows/",
      "definitions": ["feature-development", "bug-fix", "refactoring", "release-checklist", "incident-response", "new-developer"]
    },
    "hooks": {
      "path": "../../hooks/",
      "middleware": ["auth_check"]
    },
    "context": {
      "path": "../../scenarios/programming/fullstack/context/",
      "templates": ["project.template.yaml", "session.template.json", "architecture.md"]
    },
    "validation": {
      "entry": "../../devkit-doctor.py"
    }
  },

  "activation": {
    "triggers": [
      "帮我搭建一个全栈项目",
      "从 0 到 1 做 SaaS",
      "fullstack development",
      "需要前后端都做的功能"
    ]
  },

  "outputs": [
    "可运行代码仓库",
    "数据库 migration 文件",
    "API 文档 (OpenAPI/Swagger)",
    "测试报告 (覆盖率 + E2E)",
    "部署配置 (docker-compose / CI)",
    "ADR 文档 (架构决策记录)",
    "CHANGELOG + Release Notes"
  ],

  "metadata": {
    "tech_stack": {
      "frontend": ["Next.js 15", "React 19", "Tailwind v4", "TanStack Query"],
      "backend": ["FastAPI", "Pydantic", "SQLAlchemy async", "Alembic"],
      "database": ["PostgreSQL 16", "Redis 7", "Qdrant"],
      "devops": ["Docker", "GitHub Actions", "Railway", "Vercel"]
    },
    "methodology": ["Scrum+ShapeUp", "RICE", "TDD", "WCAG AA", "OWASP Top 10"]
  }
}
